{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": "src",
    "outDir": "dist",
    "sourceMap": true,
    "noImplicitAny": true
  },
  "strict": true,
  "esModuleInterop": true,
  "skipLibCheck": false, // Enable full type checking
  "forceConsistentCasingInFileNames": true,
  "resolveJsonModule": true,
  "types": ["node"],
  "typeRoots": ["node_modules/@types"],
  "exclude": ["node_modules"],
  "include": ["src/**/*"]
}
